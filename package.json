{
  "name": "tokitoki-vscode",
  "displayName": "Tokitoki",
  "description": "%extension.description%",
  "version": "0.1.5",
  "publisher": "tokitoki",
  "license": "MIT",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "time tracking",
    "productivity",
    "analytics",
    "metrics",
    "ai"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build:agent": "node scripts/build-agent-binaries.js",
    "fetch:agent": "sh scripts/fetch-cli-release.sh",
    "compile": "npm run generate && tsc -p ./",
    "check": "npm run generate && tsc --noEmit -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "generate": "node scripts/generate-server-url.js"
  },
  "contributes": {
    "icons": {
      "tokitoki-logo": {
        "description": "Tokitoki logo",
        "default": {
          "fontPath": "images/tokitoki-icon.woff",
          "fontCharacter": "\\E900"
        }
      }
    },
    "commands": [
      {
        "command": "tokitoki.setApiKey",
        "title": "%command.setApiKey.title%",
        "category": "Tokitoki",
        "icon": "$(key)"
      },
      {
        "command": "tokitoki.openDashboard",
        "title": "%command.openDashboard.title%",
        "category": "Tokitoki",
        "icon": "$(graph)"
      },
      {
        "command": "tokitoki.showApiKeyStatus",
        "title": "%command.showApiKeyStatus.title%",
        "category": "Tokitoki",
        "icon": "$(shield)"
      },
      {
        "command": "tokitoki.setProjectName",
        "title": "%command.setProjectName.title%",
        "category": "Tokitoki",
        "icon": "$(tag)"
      }
    ],
    "configuration": {
      "title": "Tokitoki",
      "properties": {
        "tokitoki.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%config.statusBar.enabled.description%"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "^3.6.1",
    "typescript": "^5.9.3"
  },
  "icon": "images/icon.png",
  "homepage": "https://tokitoki.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/tokitoki-dev/tokitoki-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/tokitoki-dev/tokitoki-vscode/issues"
  },
  "galleryBanner": {
    "color": "#18181B",
    "theme": "dark"
  },
  "pricing": "Free"
}
