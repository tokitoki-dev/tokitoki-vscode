{
  "name": "tokitoki-vscode",
  "displayName": "Tokitoki",
  "description": "Automatic coding time tracking plus AI usage analytics for Claude Code, Codex, Copilot, and more \u2014 on your Tokitoki dashboard.",
  "version": "0.1.1",
  "publisher": "tokitoki",
  "license": "MIT",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "time tracking",
    "productivity",
    "analytics",
    "metrics",
    "ai"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build:agent": "node scripts/build-agent-binaries.js",
    "fetch:agent": "sh scripts/fetch-cli-release.sh",
    "compile": "npm run generate && tsc -p ./",
    "check": "npm run generate && tsc --noEmit -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "generate": "node scripts/generate-server-url.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "tokitoki.openDashboard",
        "title": "Open Dashboard",
        "category": "Tokitoki",
        "icon": "$(graph)"
      },
      {
        "command": "tokitoki.syncNow",
        "title": "Sync AI Usage Now",
        "category": "Tokitoki",
        "icon": "$(sync)"
      },
      {
        "command": "tokitoki.setApiKey",
        "title": "Set API Key",
        "category": "Tokitoki",
        "icon": "$(key)"
      },
      {
        "command": "tokitoki.showApiKeyStatus",
        "title": "Show API Key Status",
        "category": "Tokitoki",
        "icon": "$(shield)"
      },
      {
        "command": "tokitoki.openOutput",
        "title": "Open Output Log",
        "category": "Tokitoki",
        "icon": "$(output)"
      }
    ],
    "configuration": {
      "title": "Tokitoki",
      "properties": {
        "tokitoki.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Enable coding time tracking and AI usage sync."
        },
        "tokitoki.autoSync": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Scan and upload local AI usage when VS Code starts and then on an interval."
        },
        "tokitoki.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Server override for staging or self-hosted deployments. Empty uses the server fixed at build time (https://tokitoki.dev)."
        },
        "tokitoki.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show the Tokitoki status bar item."
        },
        "tokitoki.showNotifications": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show VS Code notifications for command failures and manual command results."
        },
        "tokitoki.commandTimeoutSeconds": {
          "type": "number",
          "default": 140,
          "minimum": 5,
          "scope": "application",
          "description": "Maximum seconds to wait for a single tokitoki CLI command."
        },
        "tokitoki.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "scope": "application",
          "description": "Minimum level written to the Tokitoki output channel."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "^3.6.1",
    "typescript": "^5.9.3"
  },
  "icon": "images/icon.png",
  "homepage": "https://tokitoki.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/tokitoki-dev/tokitoki-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/tokitoki-dev/tokitoki-vscode/issues"
  },
  "galleryBanner": {
    "color": "#18181B",
    "theme": "dark"
  },
  "pricing": "Free"
}
