{
  "name": "tokitoki-vscode",
  "displayName": "Tokitoki",
  "description": "%extension.description%",
  "version": "0.1.8",
  "publisher": "tokitoki",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "time tracking",
    "productivity",
    "analytics",
    "metrics",
    "ai",
    "claude code",
    "copilot",
    "codex",
    "token cost",
    "wakatime"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build:agent": "node scripts/build-agent-binaries.js",
    "build:agent:dev": "node scripts/build-agent-binaries.js host",
    "fetch:agent": "sh scripts/fetch-cli-release.sh",
    "compile": "npm run generate && tsc -p ./",
    "check": "npm run generate && tsc --noEmit -p ./ && npm run check:l10n",
    "check:l10n": "node scripts/check-l10n.js",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && npm run check:l10n && node --test \"out/test/*.test.js\"",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "generate": "node scripts/generate-server-url.js",
    "publish:open-vsx": "sh scripts/publish-open-vsx.sh"
  },
  "contributes": {
    "icons": {
      "tokitoki-logo": {
        "description": "Tokitoki logo",
        "default": {
          "fontPath": "images/tokitoki-icon.woff",
          "fontCharacter": "\\E900"
        }
      }
    },
    "commands": [
      {
        "command": "tokitoki.setApiKey",
        "title": "%command.setApiKey.title%",
        "category": "Tokitoki",
        "icon": "$(key)"
      },
      {
        "command": "tokitoki.openDashboard",
        "title": "%command.openDashboard.title%",
        "category": "Tokitoki",
        "icon": "$(graph)"
      },
      {
        "command": "tokitoki.showApiKeyStatus",
        "title": "%command.showApiKeyStatus.title%",
        "category": "Tokitoki",
        "icon": "$(shield)"
      },
      {
        "command": "tokitoki.setProjectName",
        "title": "%command.setProjectName.title%",
        "category": "Tokitoki",
        "icon": "$(tag)"
      },
      {
        "command": "tokitoki.refreshStats",
        "title": "%command.refreshStats.title%",
        "category": "Tokitoki",
        "icon": "$(refresh)"
      },
      {
        "command": "tokitoki.openSettings",
        "title": "%command.openSettings.title%",
        "category": "Tokitoki",
        "icon": "$(gear)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokitoki",
          "title": "Tokitoki",
          "icon": "images/tokitoki-logo.svg"
        }
      ]
    },
    "views": {
      "tokitoki": [
        {
          "type": "webview",
          "id": "tokitoki.statsView",
          "name": "%view.stats.name%",
          "icon": "images/tokitoki-logo.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "tokitoki.refreshStats",
          "when": "view == tokitoki.statsView",
          "group": "navigation@1"
        },
        {
          "command": "tokitoki.openDashboard",
          "when": "view == tokitoki.statsView && tokitoki.apiKeyConfigured",
          "group": "navigation@2"
        },
        {
          "command": "tokitoki.setProjectName",
          "when": "view == tokitoki.statsView",
          "group": "1_tokitoki@1"
        },
        {
          "command": "tokitoki.showApiKeyStatus",
          "when": "view == tokitoki.statsView",
          "group": "1_tokitoki@2"
        },
        {
          "command": "tokitoki.setApiKey",
          "when": "view == tokitoki.statsView",
          "group": "1_tokitoki@3"
        },
        {
          "command": "tokitoki.openSettings",
          "when": "view == tokitoki.statsView",
          "group": "9_tokitoki@1"
        }
      ]
    },
    "configuration": {
      "title": "Tokitoki",
      "properties": {
        "tokitoki.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%config.statusBar.enabled.description%"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "^3.6.1",
    "typescript": "^5.9.3"
  },
  "icon": "images/icon.png",
  "homepage": "https://tokitoki.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/tokitoki-dev/tokitoki-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/tokitoki-dev/tokitoki-vscode/issues"
  },
  "galleryBanner": {
    "color": "#18181B",
    "theme": "dark"
  },
  "pricing": "Free"
}
