{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "group": "build",
      "problemMatcher": "$tsc",
      "options": {
        "env": {
          "TOKITOKI_BASE_URL": "http://localhost:9093"
        }
      }
    },
    {
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "options": {
        "env": {
          "TOKITOKI_BASE_URL": "http://localhost:9093"
        }
      }
    }
  ]
}
